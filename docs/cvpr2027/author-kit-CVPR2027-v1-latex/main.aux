\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Deployment-rule and training-component ablation on the same 12 evaluation datasets (8 Unseen and 4 Novel; Seen used for training only). Four-seed mean absolute values, not deltas. Dice/IoU/clDice in \%, HD95 in pixels (lower is better). ``gating + fusion'' selects and fuses candidates at test time; the following rows remove one training component. The full model uses the fixed third ranked candidate. It is not uniformly best: \emph  {w/o fusion} has lower HD95, and \emph  {w/o topology} is slightly higher on Dice/IoU.}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:dcd_ablation}{{6}{8}{Deployment-rule and training-component ablation on the same 12 evaluation datasets (8 Unseen and 4 Novel; Seen used for training only). Four-seed mean absolute values, not deltas. Dice/IoU/clDice in \%, HD95 in pixels (lower is better). ``gating + fusion'' selects and fuses candidates at test time; the following rows remove one training component. The full model uses the fixed third ranked candidate. It is not uniformly best: \emph {w/o fusion} has lower HD95, and \emph {w/o topology} is slightly higher on Dice/IoU}{table.caption.10}{}}
\newlabel{tab:dcd_ablation@cref}{{[table][6][]6}{[1][6][]8}{}{}{}}
