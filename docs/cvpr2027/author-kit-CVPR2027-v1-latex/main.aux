\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qualitative examples of the deployment rule. Each block shows a raw test image, the gating+fusion prediction, and the DCD prediction, with predictions overlaid in cyan. OCTA-500 and TopoMortar illustrate cases where DCD improves Dice or HD95; HRF and TYRE show the corresponding trade-off and failure cases. These examples are illustrative; the dataset-level quantitative comparison is in Table~\ref {tab:dcd_ablation}.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:dcd_deployment}{{3}{8}{Qualitative examples of the deployment rule. Each block shows a raw test image, the gating+fusion prediction, and the DCD prediction, with predictions overlaid in cyan. OCTA-500 and TopoMortar illustrate cases where DCD improves Dice or HD95; HRF and TYRE show the corresponding trade-off and failure cases. These examples are illustrative; the dataset-level quantitative comparison is in Table~\ref {tab:dcd_ablation}}{figure.caption.8}{}}
