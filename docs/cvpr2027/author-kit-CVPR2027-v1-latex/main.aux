\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Deployment-rule and training-component ablation on the 12 evaluation datasets. Four-seed absolute means; Dice/IoU/clDice in \%, HD95 in pixels (lower is better). ``gating + fusion'' is test-time selection and fusion on the full model's checkpoint; the full model deploys the fixed last-ranked candidate (slot 3). \emph  {W/o fusion} has lower HD95, and \emph  {w/o topology} is slightly higher on Dice/IoU.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:dcd_ablation}{{3}{7}{Deployment-rule and training-component ablation on the 12 evaluation datasets. Four-seed absolute means; Dice/IoU/clDice in \%, HD95 in pixels (lower is better). ``gating + fusion'' is test-time selection and fusion on the full model's checkpoint; the full model deploys the fixed last-ranked candidate (slot 3). \emph {W/o fusion} has lower HD95, and \emph {w/o topology} is slightly higher on Dice/IoU}{table.caption.8}{}}
\newlabel{tab:dcd_ablation@cref}{{[table][3][]3}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qualitative comparison of Ours (DCD) with four baselines on five representative curvilinear datasets. The first column shows the raw input. In the prediction panels, white denotes true positives, red outlines false negatives, and green outlines false positives; black denotes background. Yellow insets magnify the same local region in each prediction column.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:dcd_showcase}{{3}{7}{Qualitative comparison of Ours (DCD) with four baselines on five representative curvilinear datasets. The first column shows the raw input. In the prediction panels, white denotes true positives, red outlines false negatives, and green outlines false positives; black denotes background. Yellow insets magnify the same local region in each prediction column}{figure.caption.12}{}}
