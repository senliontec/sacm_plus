\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of DCD. A frozen SAM ViT-L encoder is adapted with block-internal Adapter-I and block-external Adapter-E features, which Adapter-F fuses into the decoder. Stage-1 ranks four candidate masks by gating confidence, and Stage-2 refines them with dense, topology, and role-specific losses. At inference, DCD deploys a fixed slot (slot~3), without a test-time selector or the training-only fusion branch.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:dcd_framework}{{2}{4}{Overview of DCD. A frozen SAM ViT-L encoder is adapted with block-internal Adapter-I and block-external Adapter-E features, which Adapter-F fuses into the decoder. Stage-1 ranks four candidate masks by gating confidence, and Stage-2 refines them with dense, topology, and role-specific losses. At inference, DCD deploys a fixed slot (slot~3), without a test-time selector or the training-only fusion branch}{figure.caption.2}{}}
\newlabel{fig:dcd_framework@cref}{{[figure][2][]2}{[1][3][]4}{}{}{}}
